# Copy this file to .env and replace every placeholder before starting the server.
GOMATCH_DB_URL=jdbc:mysql://127.0.0.1:3306/gomatch?useUnicode=true&characterEncoding=utf8&connectionCollation=utf8mb4_unicode_ci&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
GOMATCH_DB_USERNAME=your_mysql_username
GOMATCH_DB_PASSWORD=your_mysql_password

GOMATCH_REDIS_HOST=127.0.0.1
GOMATCH_REDIS_PORT=6379
GOMATCH_REDIS_PASSWORD=your_redis_password
GOMATCH_REDIS_DATABASE=0

# Optional: required only when OSS-backed avatar or music storage is enabled.
OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
OSS_BUCKET=your_oss_bucket
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
