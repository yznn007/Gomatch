<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.gomatch.client.ui.ProfileController"
            styleClass="page-root">
    <top>
        <VBox spacing="0">
            <HBox alignment="CENTER_LEFT" spacing="18" style="-fx-padding: 0 0 10 0;">
                <Button text="« 返回" onAction="#handleBack" styleClass="icon-btn"/>
                <Label text="个人中心" styleClass="title"/>
            </HBox>
            <Separator styleClass="section-divider" prefWidth="Infinity"/>
        </VBox>
    </top>
    <center>
        <!-- 主布局：水平分布左侧导航栏与右侧动态内容区 -->
        <HBox spacing="24" alignment="TOP_CENTER" style="-fx-padding: 18 0 0 0;">
            
            <!-- 左侧导航栏 VBox (使用微透磨砂底卡片，统一图标字符范围以保障尺寸完全一致) -->
            <VBox spacing="8" alignment="TOP_CENTER" styleClass="card" prefWidth="180" minWidth="180" style="-fx-padding: 20 10; -fx-background-color: rgba(245, 247, 250, 0.65);">
                <Button fx:id="menuInfoBtn" text="👤 个人信息" onAction="#showInfoTab" styleClass="sidebar-menu-btn"/>
                <Button fx:id="menuRecordBtn" text="📝 对战记录" onAction="#showRecordTab" styleClass="sidebar-menu-btn"/>
                <Button fx:id="menuPwdBtn" text="🔒 修改密码" onAction="#showPwdTab" styleClass="sidebar-menu-btn"/>
            </VBox>

            <!-- 右侧内容区域，带纵向 ScrollPane 适应较小窗口 -->
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" styleClass="scroll-pane" HBox.hgrow="ALWAYS">
                <StackPane alignment="CENTER" style="-fx-background-color: transparent;">
                    
                    <!-- 面板 1: 个人信息 (Grid) -->
                    <VBox fx:id="infoPane" spacing="16" alignment="TOP_CENTER" maxWidth="560" prefWidth="560" style="-fx-background-color: transparent; -fx-padding: 0 16 0 0;">
                        <Label text="基本信息" styleClass="section-label" style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-padding: 0 0 10 0;"/>
                        <GridPane hgap="24" vgap="12" alignment="CENTER" style="-fx-padding: 10 0;">
                            <columnConstraints>
                                <ColumnConstraints minWidth="120" prefWidth="120" halignment="RIGHT"/>
                                <ColumnConstraints minWidth="180" prefWidth="180" halignment="LEFT"/>
                            </columnConstraints>
                            
                            <Label text="用户ID" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="muted"/>
                            <Label fx:id="userIdLabel" GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="section-label"/>
                            
                            <Label text="用户名" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="muted"/>
                            <Label fx:id="usernameLabel" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="section-label"/>
                            
                            <Label text="当前积分" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="muted"/>
                            <Label fx:id="scoreLabel" GridPane.rowIndex="2" GridPane.columnIndex="1" styleClass="section-label"/>
                            
                            <Label text="胜场数" GridPane.rowIndex="3" GridPane.columnIndex="0" styleClass="muted"/>
                            <Label fx:id="winLabel" GridPane.rowIndex="3" GridPane.columnIndex="1" styleClass="section-label"/>
                            
                            <Label text="负场数" GridPane.rowIndex="4" GridPane.columnIndex="0" styleClass="muted"/>
                            <Label fx:id="loseLabel" GridPane.rowIndex="4" GridPane.columnIndex="1" styleClass="section-label"/>
                            
                            <Label text="平局数" GridPane.rowIndex="5" GridPane.columnIndex="0" styleClass="muted"/>
                            <Label fx:id="drawLabel" GridPane.rowIndex="5" GridPane.columnIndex="1" styleClass="section-label"/>
                        </GridPane>
                    </VBox>

                    <!-- 面板 2: 对战记录 (Table) -->
                    <VBox fx:id="recordPane" spacing="16" alignment="TOP_CENTER" maxWidth="560" prefWidth="560" style="-fx-background-color: transparent; -fx-padding: 0 16 0 0;">
                        <Label text="对战记录列表" styleClass="section-label" style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-padding: 0 0 10 0;"/>
                        <TableView fx:id="recordTable" prefHeight="320" minHeight="240" styleClass="table-view">
                            <columns>
                                <TableColumn text="对手" fx:id="opponentCol" prefWidth="130"/>
                                <TableColumn text="结果" fx:id="resultCol" prefWidth="100"/>
                                <TableColumn text="对局时间" fx:id="timeCol" prefWidth="210"/>
                                <TableColumn text="回放" fx:id="replayCol" prefWidth="100"/>
                            </columns>
                        </TableView>
                    </VBox>

                    <!-- 面板 3: 修改密码 (Form) - 删除了顶部多余的“密码修改安全中心”标签 -->
                    <VBox fx:id="pwdPane" spacing="16" alignment="TOP_CENTER" maxWidth="380" prefWidth="380" style="-fx-background-color: transparent; -fx-padding: 20 16 20 0;">
                        <PasswordField fx:id="oldPwdField" promptText="请输入旧密码" styleClass="field" prefWidth="380"/>
                        <PasswordField fx:id="newPwdField" promptText="请输入新密码" styleClass="field" prefWidth="380"/>
                        <Label fx:id="errorLabel" text="" styleClass="error-text" wrapText="true" alignment="CENTER"/>
                        <Button text="确认修改" onAction="#handleChangePwd" styleClass="btn-primary" prefWidth="160" prefHeight="36"/>
                    </VBox>
                    
                </StackPane>
            </ScrollPane>
        </HBox>
    </center>
</BorderPane>