<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>
<?import com.gomatch.client.ui.ElasticVolumeSlider?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.gomatch.client.ui.SettingsController"
            styleClass="page-root">
    <top>
        <VBox spacing="0">
            <HBox alignment="CENTER_LEFT" spacing="18" style="-fx-padding: 0 0 10 0;">
                <Button text="« 返回" onAction="#handleBack" styleClass="icon-btn"/>
                <Label text="系统设置" styleClass="title"/>
            </HBox>
            <Separator styleClass="section-divider" prefWidth="Infinity"/>
        </VBox>
    </top>
    <center>
        <HBox spacing="24" alignment="TOP_CENTER" style="-fx-padding: 18 0 0 0;">
            
            <!-- 左侧导航栏 VBox -->
            <VBox spacing="8" alignment="TOP_CENTER" styleClass="card" prefWidth="180" minWidth="180" style="-fx-padding: 20 10; -fx-background-color: rgba(245, 247, 250, 0.65);">
                <Button fx:id="menuBaseBtn" text="⚙ 基础设置" onAction="#showBaseTab" styleClass="sidebar-menu-btn"/>
                <Button fx:id="menuGraphicsBtn" text="🖼 图像设置" onAction="#showGraphicsTab" styleClass="sidebar-menu-btn"/>
                <Button fx:id="menuAudioBtn" text="🔊 声音设置" onAction="#showAudioTab" styleClass="sidebar-menu-btn"/>
                <Button fx:id="menuStyleBtn" text="🎨 UI风格" onAction="#showStyleTab" styleClass="sidebar-menu-btn"/>
                <Button fx:id="menuServerBtn" text="📡 服务器配置" onAction="#showServerTab" styleClass="sidebar-menu-btn"/>
                <Button fx:id="menuLanguageBtn" text="🌐 语言" onAction="#showLanguageTab" styleClass="sidebar-menu-btn"/>
                <Button fx:id="menuOtherBtn" text="🛠 其他" onAction="#showOtherTab" styleClass="sidebar-menu-btn"/>
            </VBox>

            <!-- 右侧内容区域，带纵向 ScrollPane -->
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" styleClass="scroll-pane" HBox.hgrow="ALWAYS">
                <StackPane alignment="CENTER" style="-fx-background-color: transparent;">
                    
                    <!-- 面板 1: 基础设置 -->
                    <VBox fx:id="basePane" spacing="16" alignment="TOP_CENTER" maxWidth="560" prefWidth="560" style="-fx-background-color: transparent; -fx-padding: 0 16 0 0;">
                        <Label text="通用基础设置" styleClass="section-label" style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-padding: 0 0 10 0;"/>
                        <GridPane hgap="24" vgap="16" alignment="CENTER" style="-fx-padding: 10 0;">
                            <columnConstraints>
                                <ColumnConstraints minWidth="120" prefWidth="120" halignment="RIGHT"/>
                                <ColumnConstraints minWidth="240" prefWidth="240" halignment="LEFT"/>
                            </columnConstraints>
                            
                            <Label text="开机自启" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="muted"/>
                            <CheckBox text="开机自动运行客户端" GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="remember-checkbox"/>
                            
                            <Label text="记住密码" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="muted"/>
                            <CheckBox text="登录页默认记住密码" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="remember-checkbox" selected="true"/>
                        </GridPane>
                    </VBox>

                    <!-- 面板 2: 图像设置 -->
                    <VBox fx:id="graphicsPane" spacing="16" alignment="TOP_CENTER" maxWidth="560" prefWidth="560" style="-fx-background-color: transparent; -fx-padding: 0 16 0 0;">
                        <Label text="图形与显示设置" styleClass="section-label" style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-padding: 0 0 10 0;"/>
                        <GridPane hgap="24" vgap="16" alignment="CENTER" style="-fx-padding: 10 0;">
                            <columnConstraints>
                                <ColumnConstraints minWidth="120" prefWidth="120" halignment="RIGHT"/>
                                <ColumnConstraints minWidth="240" prefWidth="240" halignment="LEFT"/>
                            </columnConstraints>
                            
                            <Label text="屏幕分辨率" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="muted"/>
                            <ComboBox prefWidth="200" value="900x640 (默认)" GridPane.rowIndex="0" GridPane.columnIndex="1">
                                <items>
                                    <FXCollections fx:factory="observableArrayList">
                                        <String fx:value="900x640 (默认)"/>
                                        <String fx:value="1024x768"/>
                                        <String fx:value="1280x720"/>
                                    </FXCollections>
                                </items>
                            </ComboBox>
                            
                            <Label text="全屏模式" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="muted"/>
                            <CheckBox text="启用全屏模式" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="remember-checkbox" selected="false"/>
                            
                            <Label text="垂直同步" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="muted"/>
                            <CheckBox text="启用垂直同步 (VSync)" GridPane.rowIndex="2" GridPane.columnIndex="1" styleClass="remember-checkbox" selected="true"/>
                            
                            <Label text="帧率限制" GridPane.rowIndex="3" GridPane.columnIndex="0" styleClass="muted"/>
                            <ComboBox prefWidth="200" value="60 FPS" GridPane.rowIndex="3" GridPane.columnIndex="1">
                                <items>
                                    <FXCollections fx:factory="observableArrayList">
                                        <String fx:value="60 FPS"/>
                                        <String fx:value="120 FPS"/>
                                        <String fx:value="无限制"/>
                                    </FXCollections>
                                </items>
                            </ComboBox>
                        </GridPane>
                    </VBox>

                    <!-- 面板 3: 声音设置 -->
                    <VBox fx:id="audioPane" spacing="16" alignment="TOP_CENTER" maxWidth="560" prefWidth="560" style="-fx-background-color: transparent; -fx-padding: 0 16 0 0;">
                        <Label text="声音与音效" styleClass="section-label" style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-padding: 0 0 10 0;"/>
                        <GridPane hgap="24" vgap="16" alignment="CENTER" style="-fx-padding: 10 0;">
                            <columnConstraints>
                                <ColumnConstraints minWidth="120" prefWidth="120" halignment="RIGHT"/>
                                <ColumnConstraints minWidth="240" prefWidth="240" halignment="LEFT"/>
                            </columnConstraints>
                            
                            <Label text="全局音乐" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="muted"/>
                            <HBox spacing="10" alignment="CENTER_LEFT" styleClass="audio-control-row" GridPane.rowIndex="0" GridPane.columnIndex="1">
                                <CheckBox fx:id="globalMusicCheckBox" styleClass="remember-checkbox" selected="true"/>
                                <ElasticVolumeSlider fx:id="globalVolumeSlider"
                                                     startingValue="0"
                                                     maxValue="100"
                                                     value="45"
                                                     stepped="true"
                                                     stepSize="5"
                                                     leftIconText="−"
                                                     rightIconText="+"/>
                            </HBox>
                            
                            <Label text="背景音乐" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="muted"/>
                            <HBox spacing="10" alignment="CENTER_LEFT" styleClass="audio-control-row" GridPane.rowIndex="1" GridPane.columnIndex="1">
                                <CheckBox fx:id="backgroundMusicCheckBox" styleClass="remember-checkbox" selected="true"/>
                                <ElasticVolumeSlider fx:id="backgroundVolumeSlider"
                                                     startingValue="0"
                                                     maxValue="100"
                                                     value="35"
                                                     stepped="true"
                                                     stepSize="5"
                                                     leftIconText="−"
                                                     rightIconText="+"/>
                            </HBox>
                            
                            <Label text="音效" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="muted"/>
                            <HBox spacing="10" alignment="CENTER_LEFT" styleClass="audio-control-row" GridPane.rowIndex="2" GridPane.columnIndex="1">
                                <CheckBox fx:id="soundCheckBox" styleClass="remember-checkbox" selected="true"/>
                                <ElasticVolumeSlider fx:id="soundVolumeSlider"
                                                     startingValue="0"
                                                     maxValue="100"
                                                     value="85"
                                                     stepped="true"
                                                     stepSize="5"
                                                     leftIconText="−"
                                                     rightIconText="+"/>
                            </HBox>
                            
                            <Label text="大厅歌曲" GridPane.rowIndex="3" GridPane.columnIndex="0" styleClass="muted"/>
                            <ComboBox fx:id="lobbySongComboBox" prefWidth="220" value="默认主题曲" GridPane.rowIndex="3" GridPane.columnIndex="1">
                                <items>
                                    <FXCollections fx:factory="observableArrayList">
                                        <String fx:value="默认主题曲"/>
                                        <String fx:value="清晨棋局"/>
                                        <String fx:value="静夜对弈"/>
                                        <String fx:value="赛场低语"/>
                                    </FXCollections>
                                </items>
                            </ComboBox>
                            
                            <Label text="后台静音" GridPane.rowIndex="4" GridPane.columnIndex="0" styleClass="muted"/>
                            <CheckBox GridPane.rowIndex="4" GridPane.columnIndex="1" styleClass="remember-checkbox" selected="false"/>
                        </GridPane>
                    </VBox>

                    <!-- 面板 4: UI风格 -->
                    <VBox fx:id="stylePane" spacing="16" alignment="TOP_CENTER" maxWidth="560" prefWidth="560" style="-fx-background-color: transparent; -fx-padding: 0 16 0 0;">
                        <Label text="界面与主题风格" styleClass="section-label" style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-padding: 0 0 10 0;"/>
                        <GridPane hgap="24" vgap="16" alignment="CENTER" style="-fx-padding: 10 0;">
                            <columnConstraints>
                                <ColumnConstraints minWidth="120" prefWidth="120" halignment="RIGHT"/>
                                <ColumnConstraints minWidth="240" prefWidth="240" halignment="LEFT"/>
                            </columnConstraints>
                            
                            <Label text="主题风格" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="muted"/>
                            <ComboBox prefWidth="200" value="清透白磨砂 (默认)" GridPane.rowIndex="0" GridPane.columnIndex="1">
                                <items>
                                    <FXCollections fx:factory="observableArrayList">
                                        <String fx:value="清透白磨砂 (默认)"/>
                                        <String fx:value="暗夜黑磨砂 (开发中)"/>
                                    </FXCollections>
                                </items>
                            </ComboBox>
                            
                            <Label text="动态背景" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="muted"/>
                            <CheckBox text="启用大厅粒子网格动态特效" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="remember-checkbox" selected="true"/>
                            
                            <Label text="字体类型" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="muted"/>
                            <ComboBox prefWidth="200" value="等宽 Maple Mono (推荐)" GridPane.rowIndex="2" GridPane.columnIndex="1">
                                <items>
                                    <FXCollections fx:factory="observableArrayList">
                                        <String fx:value="等宽 Maple Mono (推荐)"/>
                                        <String fx:value="系统默认字体"/>
                                    </FXCollections>
                                </items>
                            </ComboBox>
                        </GridPane>
                    </VBox>

                    <!-- 面板 5: 服务器配置 -->
                    <VBox fx:id="serverPane" spacing="16" alignment="TOP_CENTER" maxWidth="560" prefWidth="560" style="-fx-background-color: transparent; -fx-padding: 0 16 0 0;">
                        <Label text="当前服务器环境" styleClass="section-label" style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-padding: 0 0 10 0;"/>
                        <GridPane hgap="24" vgap="16" alignment="CENTER" style="-fx-padding: 10 0;">
                            <columnConstraints>
                                <ColumnConstraints minWidth="120" prefWidth="120" halignment="RIGHT"/>
                                <ColumnConstraints minWidth="240" prefWidth="240" halignment="LEFT"/>
                            </columnConstraints>
                            
                            <Label text="服务器 IP" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="muted"/>
                            <ComboBox fx:id="ipComboBox" editable="true" prefWidth="200" GridPane.rowIndex="0" GridPane.columnIndex="1">
                                <items>
                                    <FXCollections fx:factory="observableArrayList">
                                        <String fx:value="127.0.0.1"/>
                                    </FXCollections>
                                </items>
                            </ComboBox>
                            
                            <Label text="服务器端口" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="muted"/>
                            <TextField fx:id="portField" prefWidth="200" styleClass="field" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                            
                            <Label text="连接状态" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="muted"/>
                            <Label fx:id="statusLabel" text="" GridPane.rowIndex="2" GridPane.columnIndex="1" styleClass="section-label"/>
                        </GridPane>
                        <Button text="应用配置" onAction="#handleSaveConfig" styleClass="btn-secondary" prefWidth="150" style="-fx-margin-top: 15;"/>
                    </VBox>

                    <!-- 面板 6: 语言 -->
                    <VBox fx:id="languagePane" spacing="16" alignment="TOP_CENTER" maxWidth="560" prefWidth="560" style="-fx-background-color: transparent; -fx-padding: 0 16 0 0;">
                        <Label text="语言与本地化" styleClass="section-label" style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-padding: 0 0 10 0;"/>
                        <GridPane hgap="24" vgap="16" alignment="CENTER" style="-fx-padding: 10 0;">
                            <columnConstraints>
                                <ColumnConstraints minWidth="120" prefWidth="120" halignment="RIGHT"/>
                                <ColumnConstraints minWidth="240" prefWidth="240" halignment="LEFT"/>
                            </columnConstraints>
                            
                            <Label text="系统语言" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="muted"/>
                            <ComboBox prefWidth="200" value="简体中文 (Chinese)" GridPane.rowIndex="0" GridPane.columnIndex="1">
                                <items>
                                    <FXCollections fx:factory="observableArrayList">
                                        <String fx:value="简体中文 (Chinese)"/>
                                        <String fx:value="English (US)"/>
                                    </FXCollections>
                                </items>
                            </ComboBox>
                        </GridPane>
                    </VBox>
                    
                    <!-- 面板 7: 其他 -->
                    <VBox fx:id="otherPane" spacing="16" alignment="TOP_CENTER" maxWidth="380" prefWidth="380" style="-fx-background-color: transparent; -fx-padding: 20 16 20 0;">
                        <Label text="账户与游戏退出" styleClass="section-label" style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-padding: 0 0 10 0;"/>
                        <Button fx:id="logoutBtn" text="退出登录" onAction="#handleLogout" styleClass="btn-primary" prefWidth="200" style="-fx-text-fill: #334155; -fx-border-color: transparent transparent rgba(51, 65, 85, 0.2) transparent;"/>
                        <Button fx:id="exitBtn" text="退出游戏" onAction="#handleExitGame" styleClass="btn-primary" prefWidth="200" style="-fx-text-fill: #dc2626; -fx-border-color: transparent transparent rgba(220, 38, 38, 0.2) transparent;"/>
                    </VBox>
                    
                </StackPane>
            </ScrollPane>
        </HBox>
    </center>
</BorderPane>
