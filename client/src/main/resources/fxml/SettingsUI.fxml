<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import com.gomatch.client.ui.ElasticVolumeSlider?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.gomatch.client.ui.SettingsController"
            styleClass="page-root">
    <top>
        <VBox spacing="0">
            <HBox alignment="CENTER_LEFT" spacing="18" style="-fx-padding: 0 0 10 0;">
                <Button text="%settings.back" onAction="#handleBack" styleClass="icon-btn"/>
                <Label text="%settings.title" styleClass="title"/>
            </HBox>
            <Separator styleClass="section-divider" prefWidth="Infinity"/>
        </VBox>
    </top>
    <center>
        <HBox spacing="24" alignment="TOP_CENTER" style="-fx-padding: 18 0 0 0;">
            
            <!-- 左侧导航栏 VBox -->
            <VBox spacing="8" alignment="TOP_CENTER" styleClass="card" prefWidth="180" minWidth="180" style="-fx-padding: 20 10; -fx-background-color: rgba(245, 247, 250, 0.65);">
                <Button fx:id="menuBaseBtn" text="%settings.base" onAction="#showBaseTab" styleClass="sidebar-menu-btn"/>
                <Button fx:id="menuGraphicsBtn" text="%settings.graphics" onAction="#showGraphicsTab" styleClass="sidebar-menu-btn"/>
                <Button fx:id="menuAudioBtn" text="%settings.audio" onAction="#showAudioTab" styleClass="sidebar-menu-btn"/>
                <Button fx:id="menuStyleBtn" text="%settings.style" onAction="#showStyleTab" styleClass="sidebar-menu-btn"/>
                <Button fx:id="menuServerBtn" text="%settings.server" onAction="#showServerTab" styleClass="sidebar-menu-btn"/>
                <Button fx:id="menuLanguageBtn" text="%settings.language" onAction="#showLanguageTab" styleClass="sidebar-menu-btn"/>
                <Button fx:id="menuOtherBtn" text="%settings.other" onAction="#showOtherTab" styleClass="sidebar-menu-btn"/>
            </VBox>

            <!-- 右侧内容区域，带纵向 ScrollPane -->
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" styleClass="scroll-pane" HBox.hgrow="ALWAYS">
                <StackPane alignment="CENTER" style="-fx-background-color: transparent;">
                    
                    <!-- 面板 1: 基础设置 -->
                    <VBox fx:id="basePane" spacing="16" alignment="TOP_CENTER" maxWidth="560" prefWidth="560" style="-fx-background-color: transparent; -fx-padding: 0 16 0 0;">
                        <Label text="%settings.baseTitle" styleClass="section-label" style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-padding: 0 0 10 0;"/>
                        <GridPane hgap="24" vgap="16" alignment="CENTER" style="-fx-padding: 10 0;">
                            <columnConstraints>
                                <ColumnConstraints minWidth="120" prefWidth="120" halignment="RIGHT"/>
                                <ColumnConstraints minWidth="240" prefWidth="240" halignment="LEFT"/>
                            </columnConstraints>
                            
                            <Label text="%settings.autoStart" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="muted"/>
                            <CheckBox fx:id="autoStartCheckBox" text="%settings.autoStartDesc" onAction="#handleAutoStart" GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="remember-checkbox"/>

                            <Label text="%settings.rememberPwd" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="muted"/>
                            <CheckBox fx:id="rememberPasswordCheckBox" text="%settings.rememberPwdDesc" onAction="#handleRememberPassword" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="remember-checkbox" selected="true"/>
                        </GridPane>
                    </VBox>

                    <!-- 面板 2: 图像设置 -->
                    <VBox fx:id="graphicsPane" spacing="16" alignment="TOP_CENTER" maxWidth="560" prefWidth="560" style="-fx-background-color: transparent; -fx-padding: 0 16 0 0;">
                        <Label text="%settings.graphicsTitle" styleClass="section-label" style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-padding: 0 0 10 0;"/>
                        <GridPane hgap="24" vgap="16" alignment="CENTER" style="-fx-padding: 10 0;">
                            <columnConstraints>
                                <ColumnConstraints minWidth="120" prefWidth="120" halignment="RIGHT"/>
                                <ColumnConstraints minWidth="240" prefWidth="240" halignment="LEFT"/>
                            </columnConstraints>
                            
                            <Label text="%settings.resolution" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="muted"/>
                            <ComboBox fx:id="resolutionComboBox" prefWidth="200" onAction="#handleResolution" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                            
                            <Label text="%settings.fullscreen" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="muted"/>
                            <CheckBox fx:id="fullscreenCheckBox" text="%settings.fullscreenDesc" onAction="#handleFullscreen" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="remember-checkbox" selected="false"/>
                            
                            <Label text="%settings.vsync" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="muted"/>
                            <CheckBox fx:id="vsyncCheckBox" text="%settings.vsyncDesc" onAction="#handleVSync" GridPane.rowIndex="2" GridPane.columnIndex="1" styleClass="remember-checkbox" selected="true"/>
                            
                            <Label text="%settings.fps" GridPane.rowIndex="3" GridPane.columnIndex="0" styleClass="muted"/>
                            <ComboBox fx:id="fpsComboBox" prefWidth="200" onAction="#handleFpsLimit" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                        </GridPane>
                    </VBox>

                    <!-- 面板 3: 声音设置 -->
                    <VBox fx:id="audioPane" spacing="16" alignment="TOP_CENTER" maxWidth="560" prefWidth="560" style="-fx-background-color: transparent; -fx-padding: 0 16 0 0;">
                        <Label text="%settings.audioTitle" styleClass="section-label" style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-padding: 0 0 10 0;"/>
                        <GridPane hgap="24" vgap="16" alignment="CENTER" style="-fx-padding: 10 0;">
                            <columnConstraints>
                                <ColumnConstraints minWidth="120" prefWidth="120" halignment="RIGHT"/>
                                <ColumnConstraints minWidth="240" prefWidth="240" halignment="LEFT"/>
                            </columnConstraints>
                            
                            <Label text="%settings.globalMusic" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="muted"/>
                            <HBox spacing="10" alignment="CENTER_LEFT" styleClass="audio-control-row" GridPane.rowIndex="0" GridPane.columnIndex="1">
                                <CheckBox fx:id="globalMusicCheckBox" styleClass="remember-checkbox" selected="true"/>
                                <ElasticVolumeSlider fx:id="globalVolumeSlider"
                                                     startingValue="0"
                                                     maxValue="100"
                                                     value="45"
                                                     stepped="true"
                                                     stepSize="5"
                                                     leftIconText="−"
                                                     rightIconText="+"/>
                            </HBox>
                            
                            <Label text="%settings.bgMusic" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="muted"/>
                            <HBox spacing="10" alignment="CENTER_LEFT" styleClass="audio-control-row" GridPane.rowIndex="1" GridPane.columnIndex="1">
                                <CheckBox fx:id="backgroundMusicCheckBox" styleClass="remember-checkbox" selected="true"/>
                                <ElasticVolumeSlider fx:id="backgroundVolumeSlider"
                                                     startingValue="0"
                                                     maxValue="100"
                                                     value="35"
                                                     stepped="true"
                                                     stepSize="5"
                                                     leftIconText="−"
                                                     rightIconText="+"/>
                            </HBox>
                            
                            <Label text="%settings.sound" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="muted"/>
                            <HBox spacing="10" alignment="CENTER_LEFT" styleClass="audio-control-row" GridPane.rowIndex="2" GridPane.columnIndex="1">
                                <CheckBox fx:id="soundCheckBox" styleClass="remember-checkbox" selected="true"/>
                                <ElasticVolumeSlider fx:id="soundVolumeSlider"
                                                     startingValue="0"
                                                     maxValue="100"
                                                     value="85"
                                                     stepped="true"
                                                     stepSize="5"
                                                     leftIconText="−"
                                                     rightIconText="+"/>
                            </HBox>
                            
                            <Label text="%settings.lobbySong" GridPane.rowIndex="3" GridPane.columnIndex="0" styleClass="muted"/>
                            <HBox spacing="10" alignment="CENTER_LEFT" GridPane.rowIndex="3" GridPane.columnIndex="1">
                                <ComboBox fx:id="lobbySongComboBox" prefWidth="150" minWidth="150" maxWidth="150"/>
                                <Button fx:id="playOrderBtn" onAction="#handlePlayOrderCycle" prefWidth="150" minWidth="150" maxWidth="150" styleClass="btn-secondary"/>
                            </HBox>
                            
                            <Label text="%settings.muteOnBg" GridPane.rowIndex="4" GridPane.columnIndex="0" styleClass="muted"/>
                            <CheckBox fx:id="muteOnBgCheckBox" text="%settings.muteOnBgDesc" onAction="#handleMuteOnBackground" GridPane.rowIndex="4" GridPane.columnIndex="1" styleClass="remember-checkbox" selected="false"/>
                        </GridPane>
                    </VBox>

                    <!-- 面板 4: UI风格 -->
                    <VBox fx:id="stylePane" spacing="16" alignment="TOP_CENTER" maxWidth="560" prefWidth="560" style="-fx-background-color: transparent; -fx-padding: 0 16 0 0;">
                        <Label text="%settings.styleTitle" styleClass="section-label" style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-padding: 0 0 10 0;"/>
                        <GridPane hgap="24" vgap="16" alignment="CENTER" style="-fx-padding: 10 0;">
                            <columnConstraints>
                                <ColumnConstraints minWidth="120" prefWidth="120" halignment="RIGHT"/>
                                <ColumnConstraints minWidth="240" prefWidth="240" halignment="LEFT"/>
                            </columnConstraints>
                            
                            <Label text="%settings.theme" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="muted"/>
                            <ComboBox fx:id="themeComboBox" prefWidth="200" onAction="#handleTheme" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                            
                            <Label text="%settings.dynamicBg" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="muted"/>
                            <CheckBox fx:id="dynamicBgCheckBox" text="%settings.dynamicBgDesc" onAction="#handleDynamicBackground" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="remember-checkbox" selected="true"/>
                            
                            <Label text="%settings.font" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="muted"/>
                            <ComboBox fx:id="fontComboBox" prefWidth="200" onAction="#handleFontFamily" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                        </GridPane>
                    </VBox>

                    <!-- 面板 5: 服务器配置 -->
                    <VBox fx:id="serverPane" spacing="16" alignment="TOP_CENTER" maxWidth="560" prefWidth="560" style="-fx-background-color: transparent; -fx-padding: 0 16 0 0;">
                        <Label text="%settings.serverTitle" styleClass="section-label" style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-padding: 0 0 10 0;"/>
                        <GridPane hgap="24" vgap="16" alignment="CENTER" style="-fx-padding: 10 0;">
                            <columnConstraints>
                                <ColumnConstraints minWidth="120" prefWidth="120" halignment="RIGHT"/>
                                <ColumnConstraints minWidth="240" prefWidth="240" halignment="LEFT"/>
                            </columnConstraints>
                            
                            <Label text="%settings.serverIp" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="muted"/>
                            <ComboBox fx:id="ipComboBox" editable="true" prefWidth="200" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                            
                            <Label text="%settings.serverPort" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="muted"/>
                            <TextField fx:id="portField" prefWidth="200" styleClass="field" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                            
                            <Label text="%settings.serverStatus" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="muted"/>
                            <Label fx:id="statusLabel" text="" GridPane.rowIndex="2" GridPane.columnIndex="1" styleClass="section-label"/>
                        </GridPane>
                        <Button text="%settings.applyConfig" onAction="#handleSaveConfig" styleClass="btn-secondary" prefWidth="150" style="-fx-margin-top: 15;"/>
                    </VBox>

                    <!-- 面板 6: 语言 -->
                    <VBox fx:id="languagePane" spacing="16" alignment="TOP_CENTER" maxWidth="560" prefWidth="560" style="-fx-background-color: transparent; -fx-padding: 0 16 0 0;">
                        <Label text="%settings.languageTitle" styleClass="section-label" style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-padding: 0 0 10 0;"/>
                        <GridPane hgap="24" vgap="16" alignment="CENTER" style="-fx-padding: 10 0;">
                            <columnConstraints>
                                <ColumnConstraints minWidth="120" prefWidth="120" halignment="RIGHT"/>
                                <ColumnConstraints minWidth="240" prefWidth="240" halignment="LEFT"/>
                            </columnConstraints>
                            
                            <Label text="%settings.sysLanguage" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="muted"/>
                            <ComboBox fx:id="languageComboBox" prefWidth="200" onAction="#handleLanguage" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                        </GridPane>
                    </VBox>
                    
                    <!-- 面板 7: 其他 -->
                    <VBox fx:id="otherPane" spacing="16" alignment="TOP_CENTER" maxWidth="380" prefWidth="380" style="-fx-background-color: transparent; -fx-padding: 20 16 20 0;">
                        <Label text="%settings.otherTitle" styleClass="section-label" style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-padding: 0 0 10 0;"/>
                        <Button fx:id="logoutBtn" text="%settings.logout" onAction="#handleLogout" styleClass="btn-primary" prefWidth="200" style="-fx-text-fill: #334155; -fx-border-color: transparent transparent rgba(51, 65, 85, 0.2) transparent;"/>
                        <Button fx:id="exitBtn" text="%settings.exitGame" onAction="#handleExitGame" styleClass="btn-primary" prefWidth="200" style="-fx-text-fill: #dc2626; -fx-border-color: transparent transparent rgba(220, 38, 38, 0.2) transparent;"/>
                    </VBox>
                    
                </StackPane>
            </ScrollPane>
        </HBox>
    </center>
</BorderPane>
