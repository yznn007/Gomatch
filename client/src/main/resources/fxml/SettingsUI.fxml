<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.gomatch.client.ui.SettingsController"
            styleClass="page-root">
    <top>
        <VBox spacing="0">
            <HBox alignment="CENTER_LEFT" spacing="18" style="-fx-padding: 0 0 10 0;">
                <Button text="« 返回" onAction="#handleBack" styleClass="icon-btn"/>
                <Label text="系统设置" styleClass="title"/>
            </HBox>
            <Separator styleClass="section-divider" prefWidth="Infinity"/>
        </VBox>
    </top>
    <center>
        <HBox spacing="24" alignment="TOP_CENTER" style="-fx-padding: 18 0 0 0;">
            
            <!-- 左侧导航栏 VBox -->
            <VBox spacing="8" alignment="TOP_CENTER" styleClass="card" prefWidth="180" minWidth="180" style="-fx-padding: 20 10; -fx-background-color: rgba(245, 247, 250, 0.65);">
                <Button fx:id="menuBaseBtn" text="⚙ 基础设置" onAction="#showBaseTab" styleClass="sidebar-menu-btn"/>
                <Button fx:id="menuGraphicsBtn" text="🖼 图像设置" onAction="#showGraphicsTab" styleClass="sidebar-menu-btn"/>
                <Button fx:id="menuAudioBtn" text="🔊 声音设置" onAction="#showAudioTab" styleClass="sidebar-menu-btn"/>
                <Button fx:id="menuStyleBtn" text="🎨 UI风格" onAction="#showStyleTab" styleClass="sidebar-menu-btn"/>
                <Button fx:id="menuServerBtn" text="📡 服务器配置" onAction="#showServerTab" styleClass="sidebar-menu-btn"/>
                <Button fx:id="menuExitBtn" text="🚪 安全退出" onAction="#showExitTab" styleClass="sidebar-menu-btn"/>
            </VBox>

            <!-- 右侧内容区域，带纵向 ScrollPane -->
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" styleClass="scroll-pane" HBox.hgrow="ALWAYS">
                <StackPane alignment="CENTER" style="-fx-background-color: transparent;">
                    
                    <!-- 面板 1: 基础设置 -->
                    <VBox fx:id="basePane" spacing="16" alignment="TOP_CENTER" maxWidth="560" prefWidth="560" style="-fx-background-color: transparent; -fx-padding: 0 16 0 0;">
                        <Label text="通用基础设置" styleClass="section-label" style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-padding: 0 0 10 0;"/>
                        <GridPane hgap="24" vgap="16" alignment="CENTER" style="-fx-padding: 10 0;">
                            <columnConstraints>
                                <ColumnConstraints minWidth="120" prefWidth="120" halignment="RIGHT"/>
                                <ColumnConstraints minWidth="240" prefWidth="240" halignment="LEFT"/>
                            </columnConstraints>
                            
                            <Label text="开机自启" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="muted"/>
                            <CheckBox text="开机自动运行客户端" GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="remember-checkbox"/>
                            
                            <Label text="记住密码" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="muted"/>
                            <CheckBox text="登录页默认记住密码" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="remember-checkbox" selected="true"/>
                            
                            <Label text="语言选择" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="muted"/>
                            <ComboBox prefWidth="200" value="简体中文 (Chinese)" GridPane.rowIndex="2" GridPane.columnIndex="1">
                                <items>
                                    <FXCollections fx:factory="observableArrayList">
                                        <String fx:value="简体中文 (Chinese)"/>
                                        <String fx:value="English (US)"/>
                                    </FXCollections>
                                </items>
                            </ComboBox>
                        </GridPane>
                    </VBox>

                    <!-- 面板 2: 图像设置 -->
                    <VBox fx:id="graphicsPane" spacing="16" alignment="TOP_CENTER" maxWidth="560" prefWidth="560" style="-fx-background-color: transparent; -fx-padding: 0 16 0 0;">
                        <Label text="图形与显示设置" styleClass="section-label" style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-padding: 0 0 10 0;"/>
                        <GridPane hgap="24" vgap="16" alignment="CENTER" style="-fx-padding: 10 0;">
                            <columnConstraints>
                                <ColumnConstraints minWidth="120" prefWidth="120" halignment="RIGHT"/>
                                <ColumnConstraints minWidth="240" prefWidth="240" halignment="LEFT"/>
                            </columnConstraints>
                            
                            <Label text="窗口分辨率" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="muted"/>
                            <ComboBox prefWidth="200" value="900x640 (默认)" GridPane.rowIndex="0" GridPane.columnIndex="1">
                                <items>
                                    <FXCollections fx:factory="observableArrayList">
                                        <String fx:value="900x640 (默认)"/>
                                        <String fx:value="1024x768"/>
                                        <String fx:value="1280x720"/>
                                    </FXCollections>
                                </items>
                            </ComboBox>
                            
                            <Label text="帧率限制" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="muted"/>
                            <ComboBox prefWidth="200" value="60 FPS" GridPane.rowIndex="1" GridPane.columnIndex="1">
                                <items>
                                    <FXCollections fx:factory="observableArrayList">
                                        <String fx:value="60 FPS"/>
                                        <String fx:value="120 FPS"/>
                                        <String fx:value="无限制"/>
                                    </FXCollections>
                                </items>
                            </ComboBox>
                            
                            <Label text="抗锯齿" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="muted"/>
                            <CheckBox text="启用多重采样抗锯齿 (MSAA)" GridPane.rowIndex="2" GridPane.columnIndex="1" styleClass="remember-checkbox" selected="true"/>
                        </GridPane>
                    </VBox>

                    <!-- 面板 3: 声音设置 -->
                    <VBox fx:id="audioPane" spacing="16" alignment="TOP_CENTER" maxWidth="560" prefWidth="560" style="-fx-background-color: transparent; -fx-padding: 0 16 0 0;">
                        <Label text="声音与音效" styleClass="section-label" style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-padding: 0 0 10 0;"/>
                        <GridPane hgap="24" vgap="16" alignment="CENTER" style="-fx-padding: 10 0;">
                            <columnConstraints>
                                <ColumnConstraints minWidth="120" prefWidth="120" halignment="RIGHT"/>
                                <ColumnConstraints minWidth="240" prefWidth="240" halignment="LEFT"/>
                            </columnConstraints>
                            
                            <Label text="游戏音效" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="muted"/>
                            <CheckBox fx:id="soundCheckBox" text="开启落子等动作音效" GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="remember-checkbox" selected="true"/>
                            
                            <Label text="主音量" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="muted"/>
                            <Slider min="0" max="100" value="80" showTickLabels="true" showTickMarks="true" prefWidth="200" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                            
                            <Label text="背景音乐" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="muted"/>
                            <CheckBox text="开启游戏大厅背景音乐" GridPane.rowIndex="2" GridPane.columnIndex="1" styleClass="remember-checkbox" selected="false"/>
                        </GridPane>
                    </VBox>

                    <!-- 面板 4: UI风格 -->
                    <VBox fx:id="stylePane" spacing="16" alignment="TOP_CENTER" maxWidth="560" prefWidth="560" style="-fx-background-color: transparent; -fx-padding: 0 16 0 0;">
                        <Label text="界面与主题风格" styleClass="section-label" style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-padding: 0 0 10 0;"/>
                        <GridPane hgap="24" vgap="16" alignment="CENTER" style="-fx-padding: 10 0;">
                            <columnConstraints>
                                <ColumnConstraints minWidth="120" prefWidth="120" halignment="RIGHT"/>
                                <ColumnConstraints minWidth="240" prefWidth="240" halignment="LEFT"/>
                            </columnConstraints>
                            
                            <Label text="主题风格" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="muted"/>
                            <ComboBox prefWidth="200" value="清透白磨砂 (默认)" GridPane.rowIndex="0" GridPane.columnIndex="1">
                                <items>
                                    <FXCollections fx:factory="observableArrayList">
                                        <String fx:value="清透白磨砂 (默认)"/>
                                        <String fx:value="暗夜黑磨砂 (开发中)"/>
                                    </FXCollections>
                                </items>
                            </ComboBox>
                            
                            <Label text="动态背景" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="muted"/>
                            <CheckBox text="启用大厅粒子网格动态特效" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="remember-checkbox" selected="true"/>
                            
                            <Label text="字体类型" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="muted"/>
                            <ComboBox prefWidth="200" value="等宽 Maple Mono (推荐)" GridPane.rowIndex="2" GridPane.columnIndex="1">
                                <items>
                                    <FXCollections fx:factory="observableArrayList">
                                        <String fx:value="等宽 Maple Mono (推荐)"/>
                                        <String fx:value="系统默认字体"/>
                                    </FXCollections>
                                </items>
                            </ComboBox>
                        </GridPane>
                    </VBox>

                    <!-- 面板 5: 服务器配置 -->
                    <VBox fx:id="serverPane" spacing="16" alignment="TOP_CENTER" maxWidth="560" prefWidth="560" style="-fx-background-color: transparent; -fx-padding: 0 16 0 0;">
                        <Label text="当前服务器环境" styleClass="section-label" style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-padding: 0 0 10 0;"/>
                        <GridPane hgap="24" vgap="12" alignment="CENTER" style="-fx-padding: 10 0;">
                            <columnConstraints>
                                <ColumnConstraints minWidth="120" prefWidth="120" halignment="RIGHT"/>
                                <ColumnConstraints minWidth="180" prefWidth="180" halignment="LEFT"/>
                            </columnConstraints>
                            
                            <Label text="服务器地址" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="muted"/>
                            <Label fx:id="serverLabel" text="" GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="section-label"/>
                            
                            <Label text="连接状态" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="muted"/>
                            <Label fx:id="statusLabel" text="" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="section-label"/>
                        </GridPane>
                    </VBox>

                    <!-- 面板 6: 安全退出 -->
                    <VBox fx:id="exitPane" spacing="16" alignment="TOP_CENTER" maxWidth="380" prefWidth="380" style="-fx-background-color: transparent; -fx-padding: 20 16 20 0;">
                        <Label text="账户与游戏退出" styleClass="section-label" style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-padding: 0 0 10 0;"/>
                        <Button fx:id="logoutBtn" text="退出登录" onAction="#handleLogout" styleClass="btn-primary" prefWidth="200" style="-fx-text-fill: #334155; -fx-border-color: transparent transparent rgba(51, 65, 85, 0.2) transparent;"/>
                        <Button fx:id="exitBtn" text="退出游戏" onAction="#handleExitGame" styleClass="btn-primary" prefWidth="200" style="-fx-text-fill: #dc2626; -fx-border-color: transparent transparent rgba(220, 38, 38, 0.2) transparent;"/>
                    </VBox>
                    
                </StackPane>
            </ScrollPane>
        </HBox>
    </center>
</BorderPane>
