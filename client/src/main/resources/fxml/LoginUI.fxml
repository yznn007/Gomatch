<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.gomatch.client.ui.LoginController"
            styleClass="page-root">
    <center>
        <HBox spacing="32" alignment="CENTER">
            <!-- Left: brand area (empty/minimal) -->
            <StackPane HBox.hgrow="ALWAYS" minWidth="320">
                <VBox styleClass="brand-panel" alignment="CENTER" maxWidth="360" prefHeight="500">
                    <Label text="Gomatch" styleClass="brand-logo"/>
                    <Label text="网络五子棋联机对战平台" styleClass="brand-sub"/>
                </VBox>
            </StackPane>
            <!-- Right: login card -->
            <VBox styleClass="card-padded" alignment="CENTER" spacing="18" prefWidth="400" prefHeight="500">
                <Label text="登录" styleClass="title"/>
                <Label text="输入账号进入游戏" styleClass="subtitle"/>
                <GridPane hgap="10" vgap="14" alignment="CENTER">
                    <Label text="用户名" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="section-label"/>
                    <TextField fx:id="usernameField" GridPane.rowIndex="0" GridPane.columnIndex="1"
                               styleClass="field" prefWidth="240"/>
                    <Label text="密码" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="section-label"/>
                    <PasswordField fx:id="passwordField" GridPane.rowIndex="1" GridPane.columnIndex="1"
                                    styleClass="field" prefWidth="240"/>
                    <Label fx:id="errorLabel" text="" styleClass="error-text"
                           GridPane.rowIndex="2" GridPane.columnIndex="0" GridPane.columnSpan="2"/>
                </GridPane>
                <Button text="进 入 游 戏" onAction="#handleLogin" styleClass="btn-primary"
                        prefWidth="270" prefHeight="46" style="-fx-font-size: 15px;"/>
                <HBox spacing="18" alignment="CENTER">
                    <Button text="注册账号" onAction="#handleRegister" styleClass="btn-link"/>
                    <Button text="浏览模式" onAction="#handlePreview" styleClass="btn-link"/>
                </HBox>
            </VBox>
        </HBox>
    </center>
</BorderPane>