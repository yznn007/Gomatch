<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.gomatch.client.ui.LoginController"
            styleClass="page-root">
    <center>
        <HBox spacing="40" alignment="CENTER">
            <!-- Left: brand area -->
            <StackPane HBox.hgrow="ALWAYS" minWidth="320">
                <VBox styleClass="brand-panel" alignment="CENTER" maxWidth="360" prefHeight="500">
                    <Label text="Gomatch" styleClass="brand-logo"/>
                </VBox>
            </StackPane>

            <!-- Right: login card (fixed size, never changes) -->
            <VBox styleClass="glass-card" alignment="CENTER" spacing="22"
                  prefWidth="400" prefHeight="500" maxWidth="400" maxHeight="500">
                <Label text="登录" styleClass="title" style="-fx-font-size: 26px; -fx-padding: 0 0 10 0;"/>

                <!-- 输入框组 1: 用户名/邮箱 -->
                <VBox styleClass="input-field-group" prefWidth="320" maxWidth="320" style="-fx-padding: 6 0 4 0;">
                    <TextField fx:id="usernameField" styleClass="glass-input" promptText="用户名 / 邮箱"/>
                </VBox>

                <!-- 输入框组 2: 密码 -->
                <VBox styleClass="input-field-group" prefWidth="320" maxWidth="320" style="-fx-padding: 6 0 4 0;">
                    <PasswordField fx:id="passwordField" styleClass="glass-input" promptText="密码"/>
                </VBox>

                <!-- 错误提示 -->
                <Label fx:id="errorLabel" text="" styleClass="error-text" prefWidth="320" maxWidth="320"/>

                <!-- 记住我 与 忘记密码 行 -->
                <HBox spacing="10" alignment="CENTER_LEFT" prefWidth="320" maxWidth="320">
                    <CheckBox text="记住密码" styleClass="remember-checkbox"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="忘记密码？" styleClass="btn-link" style="-fx-font-size: 13px; -fx-padding: 0;"/>
                </HBox>

                <!-- 登录按钮 (全宽) -->
                <Button text="进 入 游 戏" onAction="#handleLogin" styleClass="btn-primary"
                        prefWidth="320" prefHeight="44" maxWidth="320" style="-fx-font-size: 15px;"/>

                <!-- 注册与浏览模式 -->
                <VBox alignment="CENTER" spacing="8" prefWidth="320" maxWidth="320">
                    <HBox alignment="CENTER" spacing="4">
                        <Label text="还没有账号？" styleClass="subtitle" style="-fx-text-fill: #64748b;"/>
                        <Button text="立即注册" onAction="#handleRegister" styleClass="btn-link" style="-fx-padding: 0; -fx-font-size: 13px;"/>
                    </HBox>
                    <Button text="以游客身份进入 »" onAction="#handlePreview" styleClass="btn-link" style="-fx-padding: 4 0 0 0; -fx-font-size: 13px;"/>
                </VBox>

                <!-- 服务器地址入口（打开二级弹窗） -->
                <Button text="⚙ 服务器地址" onAction="#handleOpenServerConfig"
                        styleClass="btn-link" style="-fx-font-size: 12px; -fx-text-fill: #94a3b8; -fx-padding: 0;"/>
            </VBox>
        </HBox>
    </center>
</BorderPane>