<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import com.gomatch.client.ui.PixelCard?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.gomatch.client.ui.ForgotPasswordController"
            styleClass="page-root">
    <center>
        <PixelCard variant="blue" showParticles="false"
                   maxWidth="440" minWidth="340" prefHeight="540"
                   styleClass="auth-pixel-card">
            <VBox alignment="CENTER" spacing="20" styleClass="glass-card"
                  maxWidth="Infinity" maxHeight="Infinity"
                  style="-fx-padding: 28 32;">

                <Label text="%forgot.title" styleClass="title"
                       style="-fx-font-size: 24px; -fx-padding: 0 0 8 0;"/>

                <!-- Step 1: 邮箱输入 -->
                <VBox fx:id="stepEmailBox" alignment="CENTER" spacing="16" maxWidth="320">
                    <Label text="%forgot.emailHint" styleClass="subtitle" wrapText="true"
                           style="-fx-font-size: 13px;"/>
                    <TextField fx:id="emailField" styleClass="glass-input"
                               promptText="%forgot.emailPlaceholder"/>
                    <Button text="%forgot.sendCode" onAction="#handleSendCode"
                            styleClass="btn-primary" maxWidth="320"
                            style="-fx-font-size: 15px;"/>
                </VBox>

                <!-- Step 2: 验证码显示 + 输入 -->
                <VBox fx:id="stepCodeBox" alignment="CENTER" spacing="16" maxWidth="320"
                      visible="false" managed="false">
                    <Label styleClass="subtitle" wrapText="true" text="%forgot.codeHint"
                           style="-fx-font-size: 13px;"/>
                    <!-- 显示验证码 -->
                    <HBox alignment="CENTER" spacing="8">
                        <Label styleClass="subtitle" text="%forgot.yourCode" style="-fx-font-size: 14px;"/>
                        <Label fx:id="codeDisplayLabel" style="-fx-font-size: 32px; -fx-font-weight: bold;
                               -fx-text-fill: #475569; -fx-font-family: 'Consolas', monospace;
                               -fx-padding: 4 16; -fx-background-color: rgba(100,116,139,0.10);
                               -fx-background-radius: 8;"/>
                    </HBox>
                    <Label fx:id="codeExpiryLabel" styleClass="expiry-text" style="-fx-font-size: 12px;"/>
                    <!-- 验证码输入 -->
                    <TextField fx:id="codeField" styleClass="glass-input"
                               promptText="%forgot.codePlaceholder"/>
                    <Button text="%forgot.verifyCode" onAction="#handleVerifyCode"
                            styleClass="btn-primary" maxWidth="320"
                            style="-fx-font-size: 15px;"/>
                </VBox>

                <!-- Step 3: 新密码输入 -->
                <VBox fx:id="stepPasswordBox" alignment="CENTER" spacing="16" maxWidth="320"
                      visible="false" managed="false">
                    <Label text="%forgot.newPwdHint" styleClass="subtitle" wrapText="true"
                           style="-fx-font-size: 13px;"/>
                    <PasswordField fx:id="newPasswordField" styleClass="glass-input"
                                   promptText="%forgot.newPwd"/>
                    <PasswordField fx:id="confirmNewPasswordField" styleClass="glass-input"
                                   promptText="%forgot.confirmPwd"/>
                    <Button text="%forgot.resetPwd" onAction="#handleResetPassword"
                            styleClass="btn-primary" maxWidth="320"
                            style="-fx-font-size: 15px;"/>
                </VBox>

                <!-- 错误/提示 -->
                <Label fx:id="messageLabel" text="" maxWidth="320"
                       styleClass="error-text"
                       wrapText="true" style="-fx-font-size: 13px;"/>


                <!-- 返回按钮 -->
                <Button text="%forgot.back" onAction="#handleBack"
                        styleClass="btn-link" style="-fx-font-size: 13px; -fx-padding: 0;"/>

            </VBox>
        </PixelCard>
    </center>
</BorderPane>
