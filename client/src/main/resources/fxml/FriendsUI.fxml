<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.gomatch.client.ui.FriendsController"
            styleClass="page-root">
    <top>
        <VBox spacing="0">
            <HBox alignment="CENTER_LEFT" spacing="18" style="-fx-padding: 0 0 10 0;">
                <Button text="%settings.back" onAction="#handleBack" styleClass="icon-btn"/>
                <Label text="%friends.title" styleClass="title"/>
            </HBox>
            <Separator styleClass="section-divider" prefWidth="Infinity"/>
        </VBox>
    </top>
    <center>
        <HBox spacing="24" alignment="TOP_CENTER" style="-fx-padding: 18 0 0 0;">
            
            <!-- 左侧导航栏 VBox -->
            <VBox spacing="8" alignment="TOP_CENTER" styleClass="card" prefWidth="180" minWidth="180" style="-fx-padding: 20 10; -fx-background-color: rgba(245, 247, 250, 0.65);">
                <Button fx:id="menuMyFriendsBtn" text="%friends.my" onAction="#showMyFriendsTab" styleClass="sidebar-menu-btn"/>
                <Button fx:id="menuRequestsBtn" text="%friends.requests" onAction="#showRequestsTab" styleClass="sidebar-menu-btn"/>
                <Button fx:id="menuAddBtn" text="%friends.add" onAction="#showAddTab" styleClass="sidebar-menu-btn"/>
            </VBox>

            <!-- 右侧内容区域 -->
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" styleClass="scroll-pane" HBox.hgrow="ALWAYS">
                <StackPane alignment="CENTER" style="-fx-background-color: transparent;">
                    
                    <!-- 面板 1: 我的好友 -->
                    <VBox fx:id="myFriendsPane" spacing="16" alignment="TOP_CENTER" style="-fx-background-color: transparent; -fx-padding: 0 16 0 0;">
                        <Label text="%friends.list" styleClass="section-label" style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-padding: 0 0 10 0;"/>
                        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" styleClass="scroll-pane" prefHeight="320" minHeight="240" VBox.vgrow="ALWAYS">
                            <VBox fx:id="friendsContainer" spacing="10" style="-fx-padding: 8; -fx-background-color: transparent;"/>
                        </ScrollPane>
                    </VBox>
 
                    <!-- 面板 2: 好友请求 -->
                    <VBox fx:id="requestsPane" spacing="16" alignment="TOP_CENTER" style="-fx-background-color: transparent; -fx-padding: 0 16 0 0;">
                        <Label text="%friends.pending" styleClass="section-label" style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-padding: 0 0 10 0;"/>
                        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" styleClass="scroll-pane" prefHeight="320" minHeight="240" VBox.vgrow="ALWAYS">
                            <VBox fx:id="requestsContainer" spacing="10" style="-fx-padding: 8; -fx-background-color: transparent;"/>
                        </ScrollPane>
                    </VBox>

                    <!-- 面板 3: 添加好友 -->
                    <VBox fx:id="addPane" spacing="16" alignment="TOP_CENTER" style="-fx-background-color: transparent; -fx-padding: 20 16 20 0;">
                        <Label text="%friends.sendReq" styleClass="section-label" style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-padding: 0 0 10 0;"/>
                        <TextField fx:id="friendIdField" promptText="%friends.id" styleClass="field" prefWidth="380"/>
                        <TextField fx:id="addMsgField" promptText="%friends.msg" styleClass="field" prefWidth="380"/>
                        <Label fx:id="errorLabel" text="" styleClass="error-text" wrapText="true" alignment="CENTER"/>
                        <Button text="%friends.sendBtn" onAction="#handleAddFriend" styleClass="btn-primary" prefWidth="160" prefHeight="36"/>
                    </VBox>
                    
                </StackPane>
            </ScrollPane>
        </HBox>
    </center>
</BorderPane>
