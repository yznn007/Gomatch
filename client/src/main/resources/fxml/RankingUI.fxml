<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.gomatch.client.ui.RankingController"
            styleClass="page-root">
    <top>
        <VBox spacing="0">
            <Label text="排行榜" styleClass="title"/>
            <Separator styleClass="section-divider" prefWidth="Infinity" style="-fx-padding: 12 0 0 0;"/>
        </VBox>
    </top>
    <center>
        <TableView fx:id="rankingTable" VBox.vgrow="ALWAYS" style="-fx-padding: 8 0;">
            <columns>
                <TableColumn text="排名" fx:id="rankCol" prefWidth="100"/>
                <TableColumn text="用户名" fx:id="usernameCol" prefWidth="200"/>
                <TableColumn text="积分" fx:id="scoreCol" prefWidth="120"/>
                <TableColumn text="胜场" fx:id="winCol" prefWidth="100"/>
                <TableColumn text="负场" fx:id="loseCol" prefWidth="100"/>
                <TableColumn text="胜率" fx:id="winRateCol" prefWidth="140"/>
            </columns>
        </TableView>
    </center>
    <bottom>
        <VBox spacing="0">
            <Separator styleClass="section-divider" prefWidth="Infinity"/>
            <HBox alignment="CENTER" style="-fx-padding: 14 0 0 0;">
                <Button text="返回大厅" onAction="#handleBack" styleClass="btn-primary"/>
            </HBox>
        </VBox>
    </bottom>
</BorderPane>