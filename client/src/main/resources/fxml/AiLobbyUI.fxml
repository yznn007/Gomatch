<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.gomatch.client.ui.AiLobbyController"
            styleClass="page-root">
    <top>
        <VBox spacing="0">
            <HBox alignment="CENTER_LEFT" spacing="18">
                <Button text="« 返回" onMouseClicked="#handleBack" styleClass="icon-btn"/>
                <Label text="AI 对战" styleClass="title"/>
            </HBox>
            <Separator styleClass="section-divider" prefWidth="Infinity"/>
        </VBox>
    </top>
    <center>
        <VBox styleClass="page-root" spacing="24" alignment="CENTER">
            <Region VBox.vgrow="ALWAYS"/>
            
            <VBox styleClass="card-padded" spacing="20" prefWidth="400">
                <Label text="选择难度" styleClass="section-label"/>
                
                <VBox spacing="12">
                    <Button text="简单" onAction="#handleEasy"
                            styleClass="btn-primary" prefWidth="Infinity" style="-fx-font-size: 16px;"/>
                    <Label text="AI 会做出基础的防守和进攻，适合新手练习" styleClass="subtitle" style="-fx-padding: 0 0 8 0;"/>
                    
                    <Button text="中等" onAction="#handleMedium"
                            styleClass="btn-primary" prefWidth="Infinity" style="-fx-font-size: 16px;"/>
                    <Label text="AI 会评估局势，做出策略性选择，有一定挑战性" styleClass="subtitle" style="-fx-padding: 0 0 8 0;"/>
                    
                    <Button text="困难" onAction="#handleHard"
                            styleClass="btn-primary" prefWidth="Infinity" style="-fx-font-size: 16px;"/>
                    <Label text="AI 采用启发式评分算法，难以战胜" styleClass="subtitle"/>
                </VBox>
            </VBox>
            
            <Label fx:id="matchStatus" text="" styleClass="subtitle" style="-fx-padding: 10 0 0 0;"/>
            
            <Region VBox.vgrow="ALWAYS"/>
        </VBox>
    </center>
</BorderPane>