<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.gomatch.client.ui.RecordController"
            styleClass="page-root">
    <top>
        <VBox spacing="0">
            <Label text="对战记录" styleClass="title"/>
            <Separator styleClass="section-divider" prefWidth="Infinity" style="-fx-padding: 12 0 0 0;"/>
        </VBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" styleClass="scroll-pane" VBox.vgrow="ALWAYS" minHeight="240" prefHeight="320">
            <VBox fx:id="recordsContainer" spacing="10" style="-fx-padding: 8; -fx-background-color: transparent;"/>
        </ScrollPane>
    </center>
    <bottom>
        <VBox spacing="0">
            <Separator styleClass="section-divider" prefWidth="Infinity"/>
            <HBox alignment="CENTER" style="-fx-padding: 14 0 0 0;">
                <Button text="返回大厅" onAction="#handleBack" styleClass="btn-primary"/>
            </HBox>
        </VBox>
    </bottom>
</BorderPane>