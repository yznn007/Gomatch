<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.gomatch.client.ui.RankedLobbyController"
            styleClass="page-root">
    <top>
        <VBox spacing="0">
            <HBox alignment="CENTER_LEFT" spacing="18">
                <Button text="« 返回" onMouseClicked="#handleBack" styleClass="icon-btn"/>
                <Label text="排位大厅" styleClass="title"/>
            </HBox>
            <Separator styleClass="section-divider" prefWidth="Infinity"/>
        </VBox>
    </top>
    <center>
        <VBox styleClass="page-root" spacing="20" alignment="CENTER">
            <Region VBox.vgrow="ALWAYS"/>
            <Label fx:id="rankLabel" text="当前段位: 未定级" styleClass="title" style="-fx-font-size: 28px;"/>
            <Label text="排位胜负会计入积分与段位" styleClass="subtitle"/>
            <Button text="开 始 排 位 匹 配" onAction="#handleMatch" styleClass="mode-btn-primary"
                    prefWidth="320" prefHeight="80" style="-fx-font-size: 20px;"/>
            <Label fx:id="matchStatus" text="" styleClass="subtitle" style="-fx-padding: 10 0 0 0;"/>
            <Region VBox.vgrow="ALWAYS"/>
        </VBox>
    </center>
</BorderPane>