<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.gomatch.client.ui.CreateRoomController"
            styleClass="page-root">
    <center>
        <VBox styleClass="card-padded" alignment="CENTER" spacing="14" maxWidth="420">
            <Label text="%room.create" styleClass="title"/>
            <GridPane hgap="10" vgap="12" alignment="CENTER">
                <Label text="%room.name" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="section-label"/>
                <TextField fx:id="roomNameField" GridPane.rowIndex="0" GridPane.columnIndex="1"
                           styleClass="field" prefWidth="220"/>
                <Label text="%room.password" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="section-label"/>
                <PasswordField fx:id="passwordField" GridPane.rowIndex="1" GridPane.columnIndex="1"
                               styleClass="field" prefWidth="220"/>
                <Label fx:id="errorLabel" text="" styleClass="error-text"
                       GridPane.rowIndex="2" GridPane.columnIndex="0" GridPane.columnSpan="2"/>
            </GridPane>
            <HBox spacing="12" alignment="CENTER">
                <Button text="%room.confirm" onAction="#handleConfirm" styleClass="btn-primary"/>
                <Button text="%room.cancel" onAction="#handleCancel" styleClass="btn-secondary"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>