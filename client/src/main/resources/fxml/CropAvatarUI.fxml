<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.Group?>
<?import javafx.scene.shape.Rectangle?>

<!--
  头像裁剪弹窗。
  StackPane 固定 540×540 正方形并裁剪溢出；
  ImageView 直接放在 StackPane 中手动定位，允许拖拽/缩放；
  遮罩 Group 覆盖在最上层（mouseTransparent），按钮在 VBox 下层。
-->
<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.gomatch.client.ui.CropAvatarController"
      styleClass="crop-avatar-dialog"
      spacing="0" prefWidth="540" minWidth="540" maxWidth="540">

    <!-- 固定正方形画布 -->
    <StackPane fx:id="canvasContainer" prefWidth="540" prefHeight="540"
               minWidth="540" minHeight="540" maxWidth="540" maxHeight="540"
               style="-fx-background-color: #000000;">

        <!-- 图片层：手动定位，TOP_LEFT 确保布局起点为 (0,0) -->
        <ImageView fx:id="imageView" preserveRatio="false" mouseTransparent="false"
                   StackPane.alignment="TOP_LEFT"/>

        <!-- 遮罩层：固定不动，穿透鼠标事件 -->
        <Group fx:id="maskGroup" mouseTransparent="true">
            <Rectangle fx:id="maskTop" fill="rgba(0,0,0,0.45)" mouseTransparent="true"/>
            <Rectangle fx:id="maskBottom" fill="rgba(0,0,0,0.45)" mouseTransparent="true"/>
            <Rectangle fx:id="maskLeft" fill="rgba(0,0,0,0.45)" mouseTransparent="true"/>
            <Rectangle fx:id="maskRight" fill="rgba(0,0,0,0.45)" mouseTransparent="true"/>
            <Rectangle fx:id="cropFrame" fill="transparent"
                       stroke="rgba(255,255,255,0.9)" strokeWidth="2" mouseTransparent="true"/>
        </Group>
    </StackPane>

    <!-- 底部按钮栏：与画布完全分离 -->
    <HBox spacing="30" alignment="CENTER" prefHeight="64"
          styleClass="crop-avatar-actions" style="-fx-padding: 0 20 0 20;">
        <Button text="取消" onAction="#handleCancel" prefWidth="90" prefHeight="36"
                styleClass="btn-secondary" style="-fx-font-size: 13px;"/>
        <Button text="确定" onAction="#handleConfirm" prefWidth="90" prefHeight="36"
                styleClass="btn-success" style="-fx-font-size: 13px; -fx-font-weight: bold;"/>
    </HBox>
</VBox>
